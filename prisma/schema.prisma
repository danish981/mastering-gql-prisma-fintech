generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  CUSTOMER
  ADMIN
  SUPPORT
  MERCHANT
  PARTNER
  AUDITOR
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
  PENDING_VERIFICATION
  BLOCKED
}

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  CRYPTO
  FIXED_DEPOSIT
  LOAN
}

enum Currency {
  USD
  EUR
  GBP
  JPY
  BTC
  ETH
}

enum TransactionType {
  TRANSFER
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
  FEE
  REWARD_REDEMPTION
  LOAN_DISBURSEMENT
  LOAN_REPAYMENT
  INTEREST_CREDIT
  TAX_DEDUCTION
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum CardType {
  DEBIT
  CREDIT
  PREPAID
  VIRTUAL
}

enum CardStatus {
  ACTIVE
  BLOCKED
  EXPIRED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  TRANSACTION
  SECURITY
  ACCOUNT
  PROMOTIONAL
  SYSTEM
  REWARD
  LOAN_UPDATE
  KYC_UPDATE
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum KycStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum LoanStatus {
  APPLIED
  APPROVED
  REJECTED
  ACTIVE
  PAID_OFF
  DEFAULTED
}

enum InsuranceType {
  HEALTH
  LIFE
  TRAVEL
  AUTO
  PROPERTY
}

// ============================================
// USER & ACCESS MODELS
// ============================================

model User {
  id              Int            @id @default(autoincrement())
  email           String         @unique
  password        String         
  firstName       String
  lastName        String
  phoneNumber     String?        @unique
  dateOfBirth     DateTime?
  role            UserRole       @default(CUSTOMER)
  status          AccountStatus  @default(PENDING_VERIFICATION)
  emailVerified   Boolean        @default(false)
  kycVerified     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  lastLoginAt     DateTime?

  // Relations
  profile         UserProfile?
  accounts        Account[]
  cards           Card[]
  transactions    Transaction[]
  beneficiaries   Beneficiary[]
  sessions        Session[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  tickets         SupportTicket[]
  rewardPoints    RewardPoint[]
  redemptions     RewardRedemption[]
  merchant        Merchant?
  orders          Order[]
  savingsGoals    SavingsGoal[]
  connections     Connection[]    @relation("UserToConnection")
  connectedTo     Connection[]    @relation("TargetToConnection")
  kycDoc          KycDocument?
  verifications   KycVerification[]
  loans           Loan[]
  loanApps        LoanApplication[]
  policies        InsurancePolicy[]
  budgets         Budget[]
  subscriptions   UserSubscription[]
  apiKeys         ApiKey[]
  referrals       Referral[]      @relation("Referrer")
  referredBy      Referral?       @relation("ReferredUser")
  taxReports      TaxReport[]
  logins          LoginHistory[]

  @@index([email])
  @@index([phoneNumber])
}

model UserProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  address         String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  occupation      String?
  annualIncome    Decimal? @db.Decimal(15, 2)
  profileImageUrl String?
  bio             String?
  preferences     Json?    
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           Int      @id @default(autoincrement())
  userId       Int
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model LoginHistory {
  id           Int      @id @default(autoincrement())
  userId       Int
  ipAddress    String?
  userAgent    String?
  location     String?
  status       String   // SUCCESS, FAILED
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiKey {
  id           Int      @id @default(autoincrement())
  userId       Int
  key          String   @unique
  name         String
  scopes       String[] // read, write, etc.
  isActive     Boolean  @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// FINANCIAL CORE MODELS
// ============================================

model Account {
  id               Int           @id @default(autoincrement())
  userId           Int
  accountNumber    String        @unique
  accountType      AccountType   @default(CHECKING)
  currency         Currency      @default(USD)
  balance          Decimal       @default(0) @db.Decimal(15, 2)
  availableBalance Decimal       @default(0) @db.Decimal(15, 2)
  isDefault        Boolean       @default(false)
  status           AccountStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionsFrom Transaction[] @relation("FromAccount")
  transactionsTo   Transaction[] @relation("ToAccount")
  investments      Investment[]
  limits           AccountLimit[]
  savingsGoal      SavingsGoal?  @relation(fields: [savingsGoalId], references: [id])
  savingsGoalId    Int?
  loan             Loan?         @relation(fields: [loanId], references: [id])
  loanId           Int?          @unique

  @@index([userId])
  @@index([accountNumber])
}

model Transaction {
  id              Int               @id @default(autoincrement())
  userId          Int
  fromAccountId   Int?
  toAccountId     Int?
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  amount          Decimal           @db.Decimal(15, 2)
  currency        Currency          @default(USD)
  fee             Decimal           @default(0) @db.Decimal(15, 2)
  description     String?
  reference       String            @unique
  metadata        Json?             
  processedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account? @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount   Account? @relation("ToAccount", fields: [toAccountId], references: [id])
  order       Order?   @relation(fields: [orderId], references: [id])
  orderId     Int?     @unique
  bill        Bill?    @relation(fields: [billId], references: [id])
  billId      Int?

  @@index([userId])
  @@index([reference])
  @@index([status])
  @@index([createdAt])
}

model Card {
  id              Int        @id @default(autoincrement())
  userId          Int
  cardNumber      String     @unique
  cardHolderName  String
  cardType        CardType
  status          CardStatus @default(ACTIVE)
  expiryMonth     Int
  expiryYear      Int
  cvv             String
  creditLimit     Decimal?   @db.Decimal(15, 2)
  availableCredit Decimal?   @db.Decimal(15, 2)
  isVirtual       Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([cardNumber])
}

model Beneficiary {
  id            Int      @id @default(autoincrement())
  userId        Int
  name          String
  accountNumber String
  bankName      String
  bankCode      String?
  email         String?
  phoneNumber   String?
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// KYC & COMPLIANCE
// ============================================

model KycDocument {
  id              Int       @id @default(autoincrement())
  userId          Int       @unique
  documentType    String    // PASSPORT, DRIVING_LICENSE, ID_CARD
  documentNumber  String
  expiryDate      DateTime?
  frontImageUrl   String
  backImageUrl    String?
  status          KycStatus @default(PENDING)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KycVerification {
  id              Int       @id @default(autoincrement())
  userId          Int
  verifiedBy      Int?      // Admin user ID
  status          KycStatus
  notes           String?
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// LOANS & LENDING
// ============================================

model LoanApplication {
  id              Int        @id @default(autoincrement())
  userId          Int
  amountRequested Decimal    @db.Decimal(15, 2)
  purpose         String
  termMonths      Int
  status          LoanStatus @default(APPLIED)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Loan {
  id              Int        @id @default(autoincrement())
  userId          Int
  principalAmount Decimal    @db.Decimal(15, 2)
  interestRate    Decimal    @db.Decimal(5, 2)
  termMonths      Int
  startDate       DateTime
  endDate         DateTime
  remainingAmount Decimal    @db.Decimal(15, 2)
  status          LoanStatus @default(ACTIVE)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  repayments Repayment[]
  accounts   Account[]
}

model Repayment {
  id              Int      @id @default(autoincrement())
  loanId          Int
  amount          Decimal  @db.Decimal(15, 2)
  repaymentDate   DateTime
  principalPaid   Decimal  @db.Decimal(15, 2)
  interestPaid    Decimal  @db.Decimal(15, 2)
  createdAt       DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

// ============================================
// INSURANCE
// ============================================

model InsurancePolicy {
  id              Int           @id @default(autoincrement())
  userId          Int
  policyNumber    String        @unique
  type            InsuranceType
  premiumAmount   Decimal       @db.Decimal(15, 2)
  coverageAmount  Decimal       @db.Decimal(15, 2)
  startDate       DateTime
  endDate         DateTime
  status          String        // ACTIVE, EXPIRED, CANCELLED
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  claims InsuranceClaim[]
}

model InsuranceClaim {
  id              Int      @id @default(autoincrement())
  policyId        Int
  amountClaimed   Decimal  @db.Decimal(15, 2)
  reason          String
  status          String   // PENDING, APPROVED, REJECTED
  settledAmount   Decimal? @db.Decimal(15, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  policy InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
}

// ============================================
// BILLS & BUDGETING
// ============================================

model Biller {
  id              Int      @id @default(autoincrement())
  name            String
  category        String   // UTILITY, TELECOM, EDUCATION
  accountNumber   String?
  logoUrl         String?
  createdAt       DateTime @default(now())

  bills Bill[]
}

model Bill {
  id              Int      @id @default(autoincrement())
  billerId        Int
  amount          Decimal  @db.Decimal(15, 2)
  dueDate         DateTime
  status          String   // UNPAID, PAID, OVERDUE
  referenceNum    String?
  createdAt       DateTime @default(now())

  biller       Biller        @relation(fields: [billerId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Category {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  description     String?
  icon            String?
  
  budgets Budget[]
}

model Budget {
  id              Int      @id @default(autoincrement())
  userId          Int
  categoryId      Int
  limitAmount     Decimal  @db.Decimal(15, 2)
  spentAmount     Decimal  @default(0) @db.Decimal(15, 2)
  period          String   // MONTHLY, WEEKLY
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// MERCHANT & COMMERCE
// ============================================

model Merchant {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  businessName    String
  category        String
  taxId           String?
  website         String?
  isVerified      Boolean  @default(false)
  logoUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  orders   Order[]

  @@index([userId])
  @@index([businessName])
}

model Product {
  id          Int      @id @default(autoincrement())
  merchantId  Int
  name        String
  description String?
  price       Decimal  @db.Decimal(15, 2)
  currency    Currency @default(USD)
  stock       Int      @default(0)
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([merchantId])
}

model Order {
  id          Int         @id @default(autoincrement())
  merchantId  Int
  userId      Int
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(15, 2)
  currency    Currency    @default(USD)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  merchant    Merchant    @relation(fields: [merchantId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  transaction Transaction?

  @@index([merchantId])
  @@index([userId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Decimal @db.Decimal(15, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// ============================================
// REWARDS, LOYALTY & REFERRALS
// ============================================

model RewardPoint {
  id        Int      @id @default(autoincrement())
  userId    Int
  points    Int
  action    String   
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RewardRedemption {
  id          Int      @id @default(autoincrement())
  userId      Int
  pointsSpent Int
  valueAmount Decimal  @db.Decimal(15, 2)
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Referral {
  id              Int      @id @default(autoincrement())
  referrerId      Int
  referredUserId  Int      @unique
  referralCode    String
  status          String   // PENDING, COMPLETED, REWARDED
  rewardEarned    Int?     @default(0)
  createdAt       DateTime @default(now())

  referrer     User @relation("Referrer", fields: [referrerId], references: [id])
  referredUser User @relation("ReferredUser", fields: [referredUserId], references: [id])
}

model Voucher {
  id              Int      @id @default(autoincrement())
  code            String   @unique
  discountAmount  Decimal  @db.Decimal(15, 2)
  isPercentage    Boolean  @default(false)
  expiryDate      DateTime
  usageLimit      Int      @default(1)
  usageCount      Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}

// ============================================
// SUBSCRIPTIONS
// ============================================

model SubscriptionPlan {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  price           Decimal  @db.Decimal(15, 2)
  currency        Currency @default(USD)
  billingPeriod   String   // MONTHLY, YEARLY
  features        Json?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  subscriptions UserSubscription[]
}

model UserSubscription {
  id              Int      @id @default(autoincrement())
  userId          Int
  planId          Int
  startDate       DateTime @default(now())
  endDate         DateTime
  status          String   // ACTIVE, CANCELLED, EXPIRED
  autoRenew       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

// ============================================
// BRANCHES & INFRASTRUCTURE
// ============================================

model Branch {
  id              Int      @id @default(autoincrement())
  name            String
  code            String   @unique
  address         String
  city            String
  state           String?
  country         String
  phoneNumber     String?
  coordinates     String?  // Latitude, Longitude
  openingHours    String?
  createdAt       DateTime @default(now())

  atms ATM[]
}

model ATM {
  id              Int      @id @default(autoincrement())
  branchId        Int?
  atmNumber       String   @unique
  location        String
  city            String
  status          String   // ONLINE, OFFLINE, MAINTENANCE
  hasCash         Boolean  @default(true)
  createdAt       DateTime @default(now())

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
}

// ============================================
// LIMITS & GOALS
// ============================================

model AccountLimit {
  id          Int      @id @default(autoincrement())
  accountId   Int
  limitType   String   
  limitAmount Decimal  @db.Decimal(15, 2)
  resetPeriod String   
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model SavingsGoal {
  id            Int        @id @default(autoincrement())
  userId        Int
  name          String
  targetAmount  Decimal    @db.Decimal(15, 2)
  currentAmount Decimal    @default(0) @db.Decimal(15, 2)
  status        GoalStatus @default(ACTIVE)
  deadline      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@index([userId])
}

// ============================================
// SOCIAL & CONNECTIONS
// ============================================

model Connection {
  id           Int      @id @default(autoincrement())
  userId       Int
  targetUserId Int
  status       String   
  createdAt    DateTime @default(now())

  user   User @relation("UserToConnection", fields: [userId], references: [id])
  target User @relation("TargetToConnection", fields: [targetUserId], references: [id])

  @@unique([userId, targetUserId])
}

// ============================================
// INVESTMENT & MARKET DATA
// ============================================

model Investment {
  id            Int      @id @default(autoincrement())
  accountId     Int
  symbol        String
  assetName     String
  quantity      Decimal  @db.Decimal(18, 8)
  averagePrice  Decimal  @db.Decimal(18, 4)
  currentPrice  Decimal  @db.Decimal(18, 4)
  totalValue    Decimal  @db.Decimal(18, 2)
  plPercentage  Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([symbol])
}

model MarketData {
  id            Int      @id @default(autoincrement())
  symbol        String   @unique
  name          String
  type          String   
  currentPrice  Decimal  @db.Decimal(18, 4)
  change24h     Decimal  @db.Decimal(10, 2)
  volume24h     Decimal  @db.Decimal(20, 2)
  lastUpdated   DateTime @default(now())

  @@index([symbol])
}

// ============================================
// SYSTEM & COMPLIANCE
// ============================================

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  resource  String
  payload   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SupportTicket {
  id          Int            @id @default(autoincrement())
  userId      Int
  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  category    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Notification {
  id        Int                @id @default(autoincrement())
  userId    Int
  type      NotificationType
  status    NotificationStatus @default(UNREAD)
  title     String
  message   String
  metadata  Json?
  createdAt DateTime           @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model TaxReport {
  id              Int      @id @default(autoincrement())
  userId          Int
  year            Int
  totalIncome     Decimal  @db.Decimal(15, 2)
  taxDeducted     Decimal  @db.Decimal(15, 2)
  reportUrl       String?
  status          String   // DRAFT, SUBMITTED, APPROVED
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SystemWebhook {
  id              Int      @id @default(autoincrement())
  url             String
  events          String[] // transaction.created, etc.
  secret          String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
}
