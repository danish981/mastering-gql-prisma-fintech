generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  CUSTOMER
  ADMIN
  SUPPORT
  MERCHANT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
  PENDING_VERIFICATION
}

enum AccountType {
  CHECKING
  SAVINGS
  INVESTMENT
  CRYPTO
}

enum Currency {
  USD
  EUR
  GBP
  JPY
  BTC
  ETH
}

enum TransactionType {
  TRANSFER
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
  FEE
  REWARD_REDEMPTION
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  REVERSED
}

enum CardType {
  DEBIT
  CREDIT
  PREPAID
  VIRTUAL
}

enum CardStatus {
  ACTIVE
  BLOCKED
  EXPIRED
  CANCELLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  TRANSACTION
  SECURITY
  ACCOUNT
  PROMOTIONAL
  SYSTEM
  REWARD
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// ============================================
// USER MODELS
// ============================================

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String         
  firstName     String
  lastName      String
  phoneNumber   String?        @unique
  dateOfBirth   DateTime?
  role          UserRole       @default(CUSTOMER)
  status        AccountStatus  @default(PENDING_VERIFICATION)
  emailVerified Boolean        @default(false)
  kycVerified   Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastLoginAt   DateTime?

  // Relations
  profile       UserProfile?
  accounts      Account[]
  cards         Card[]
  transactions  Transaction[]
  beneficiaries Beneficiary[]
  sessions      Session[]
  notifications Notification[]
  auditLogs     AuditLog[]
  tickets       SupportTicket[]
  rewardPoints  RewardPoint[]
  redemptions   RewardRedemption[]
  merchant      Merchant?
  orders        Order[]
  savingsGoals  SavingsGoal[]
  connections   Connection[]    @relation("UserToConnection")
  connectedTo   Connection[]    @relation("TargetToConnection")

  @@index([email])
  @@index([phoneNumber])
}

model UserProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  address         String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  occupation      String?
  annualIncome    Decimal? @db.Decimal(15, 2)
  profileImageUrl String?
  bio             String?
  preferences     Json?    // UI preferences, theme, etc.
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id           Int      @id @default(autoincrement())
  userId       Int
  token        String   @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

// ============================================
// FINANCIAL MODELS
// ============================================

model Account {
  id               Int           @id @default(autoincrement())
  userId           Int
  accountNumber    String        @unique
  accountType      AccountType   @default(CHECKING)
  currency         Currency      @default(USD)
  balance          Decimal       @default(0) @db.Decimal(15, 2)
  availableBalance Decimal       @default(0) @db.Decimal(15, 2)
  isDefault        Boolean       @default(false)
  status           AccountStatus @default(ACTIVE)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionsFrom Transaction[] @relation("FromAccount")
  transactionsTo   Transaction[] @relation("ToAccount")
  investments      Investment[]
  limits           AccountLimit[]
  savingsGoal      SavingsGoal?  @relation(fields: [savingsGoalId], references: [id])
  savingsGoalId    Int?

  @@index([userId])
  @@index([accountNumber])
}

model Transaction {
  id              Int               @id @default(autoincrement())
  userId          Int
  fromAccountId   Int?
  toAccountId     Int?
  type            TransactionType
  status          TransactionStatus @default(PENDING)
  amount          Decimal           @db.Decimal(15, 2)
  currency        Currency          @default(USD)
  fee             Decimal           @default(0) @db.Decimal(15, 2)
  description     String?
  reference       String            @unique
  metadata        Json?             
  processedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromAccount Account? @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount   Account? @relation("ToAccount", fields: [toAccountId], references: [id])
  order       Order?   @relation(fields: [orderId], references: [id])
  orderId     Int?     @unique

  @@index([userId])
  @@index([reference])
  @@index([status])
  @@index([createdAt])
}

model Card {
  id              Int        @id @default(autoincrement())
  userId          Int
  cardNumber      String     @unique
  cardHolderName  String
  cardType        CardType
  status          CardStatus @default(ACTIVE)
  expiryMonth     Int
  expiryYear      Int
  cvv             String
  creditLimit     Decimal?   @db.Decimal(15, 2)
  availableCredit Decimal?   @db.Decimal(15, 2)
  isVirtual       Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([cardNumber])
}

model Beneficiary {
  id            Int      @id @default(autoincrement())
  userId        Int
  name          String
  accountNumber String
  bankName      String
  bankCode      String?
  email         String?
  phoneNumber   String?
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// MERCHANT & COMMERCE
// ============================================

model Merchant {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  businessName    String
  category        String
  taxId           String?
  website         String?
  isVerified      Boolean  @default(false)
  logoUrl         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]
  orders   Order[]

  @@index([userId])
  @@index([businessName])
}

model Product {
  id          Int      @id @default(autoincrement())
  merchantId  Int
  name        String
  description String?
  price       Decimal  @db.Decimal(15, 2)
  currency    Currency @default(USD)
  stock       Int      @default(0)
  imageUrl    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([merchantId])
}

model Order {
  id          Int         @id @default(autoincrement())
  merchantId  Int
  userId      Int
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(15, 2)
  currency    Currency    @default(USD)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  merchant    Merchant    @relation(fields: [merchantId], references: [id])
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  transaction Transaction?

  @@index([merchantId])
  @@index([userId])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int
  price     Decimal @db.Decimal(15, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

// ============================================
// REWARDS & LOYALTY
// ============================================

model RewardPoint {
  id        Int      @id @default(autoincrement())
  userId    Int
  points    Int
  action    String   // EARNED, SPENT, EXPIRED
  reason    String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RewardRedemption {
  id          Int      @id @default(autoincrement())
  userId      Int
  pointsSpent Int
  valueAmount Decimal  @db.Decimal(15, 2)
  description String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============================================
// LIMITS & GOALS
// ============================================

model AccountLimit {
  id          Int      @id @default(autoincrement())
  accountId   Int
  limitType   String   // DAILY_SPEND, SINGLE_TXN, MONTHLY_WITHDRAWAL
  limitAmount Decimal  @db.Decimal(15, 2)
  resetPeriod String   // DAILY, WEEKLY, MONTHLY
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model SavingsGoal {
  id            Int        @id @default(autoincrement())
  userId        Int
  name          String
  targetAmount  Decimal    @db.Decimal(15, 2)
  currentAmount Decimal    @default(0) @db.Decimal(15, 2)
  status        GoalStatus @default(ACTIVE)
  deadline      DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts Account[]

  @@index([userId])
}

// ============================================
// SOCIAL & CONNECTIONS
// ============================================

model Connection {
  id           Int      @id @default(autoincrement())
  userId       Int
  targetUserId Int
  status       String   // PENDING, ACCEPTED, BLOCKED
  createdAt    DateTime @default(now())

  user   User @relation("UserToConnection", fields: [userId], references: [id])
  target User @relation("TargetToConnection", fields: [targetUserId], references: [id])

  @@unique([userId, targetUserId])
}

// ============================================
// INVESTMENT & MARKET DATA
// ============================================

model Investment {
  id            Int      @id @default(autoincrement())
  accountId     Int
  symbol        String
  assetName     String
  quantity      Decimal  @db.Decimal(18, 8)
  averagePrice  Decimal  @db.Decimal(18, 4)
  currentPrice  Decimal  @db.Decimal(18, 4)
  totalValue    Decimal  @db.Decimal(18, 2)
  plPercentage  Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([symbol])
}

model MarketData {
  id            Int      @id @default(autoincrement())
  symbol        String   @unique
  name          String
  type          String   
  currentPrice  Decimal  @db.Decimal(18, 4)
  change24h     Decimal  @db.Decimal(10, 2)
  volume24h     Decimal  @db.Decimal(20, 2)
  lastUpdated   DateTime @default(now())

  @@index([symbol])
}

// ============================================
// SYSTEM MODELS
// ============================================

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  resource  String
  payload   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model SupportTicket {
  id          Int            @id @default(autoincrement())
  userId      Int
  subject     String
  description String
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  category    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model Notification {
  id        Int                @id @default(autoincrement())
  userId    Int
  type      NotificationType
  status    NotificationStatus @default(UNREAD)
  title     String
  message   String
  metadata  Json?
  createdAt DateTime           @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
